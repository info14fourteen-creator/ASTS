{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://asts.local/schemas/ai-review-queue.schema.json",
  "title": "ASTS AI Review Queue Fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "rule", "confidence_threshold", "blocked_below_confidence", "write_contract", "queue"],
  "properties": {
    "version": {
      "const": "0.1.0"
    },
    "rule": {
      "type": "string",
      "minLength": 1
    },
    "confidence_threshold": {
      "const": 0.85
    },
    "blocked_below_confidence": {
      "const": 0.75
    },
    "write_contract": {
      "$ref": "#/definitions/write_contract"
    },
    "queue": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/definitions/review_item"
      }
    }
  },
  "definitions": {
    "fact_type": {
      "enum": ["requirement", "supplier_quote", "economics"]
    },
    "owner_role": {
      "enum": ["tender_manager", "supplier_manager", "finance_owner"]
    },
    "source_host": {
      "const": "zakupki.gov.ru"
    },
    "write_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route",
        "method",
        "status",
        "owner",
        "idempotency_key_required",
        "request_schema",
        "blocked_copy",
        "no_merge_copy"
      ],
      "properties": {
        "route": {
          "const": "/v1/ai/review-queue"
        },
        "method": {
          "const": "POST"
        },
        "status": {
          "const": "draft"
        },
        "owner": {
          "const": "AI workflow owner"
        },
        "idempotency_key_required": {
          "const": true
        },
        "request_schema": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "uniqueItems": true,
          "items": {
            "enum": [
              "review_id",
              "fact_id",
              "owner_id",
              "owner_role",
              "action",
              "decision",
              "evidence_ref",
              "confidence_at_review",
              "source_checksum_sha256",
              "audit_note",
              "idempotency_key"
            ]
          }
        },
        "blocked_copy": {
          "type": "string",
          "minLength": 1
        },
        "no_merge_copy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "review_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tender_id",
        "document_id",
        "fact_type",
        "title",
        "extracted_value",
        "confidence",
        "owner_role",
        "required_action",
        "reason",
        "source_host"
      ],
      "properties": {
        "tender_id": {
          "type": "string",
          "minLength": 1
        },
        "document_id": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "fact_type": {
          "$ref": "#/definitions/fact_type"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "extracted_value": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.85
        },
        "owner_role": {
          "$ref": "#/definitions/owner_role"
        },
        "required_action": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "source_host": {
          "$ref": "#/definitions/source_host"
        }
      }
    }
  }
}

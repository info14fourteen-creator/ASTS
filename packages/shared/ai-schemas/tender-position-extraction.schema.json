{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://asts.local/schemas/tender-position-extraction.schema.json",
  "title": "Tender Position Extraction",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tender_id", "source_document_id", "positions"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2026-06-16"
    },
    "tender_id": {
      "type": "string",
      "minLength": 1
    },
    "source_document_id": {
      "type": "string",
      "minLength": 1
    },
    "positions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "position_id",
          "name",
          "quantity",
          "unit",
          "requirements",
          "analog_allowed",
          "confidence",
          "source_refs",
          "review_status"
        ],
        "properties": {
          "position_id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "okpd2": {
            "type": ["string", "null"]
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "analog_allowed": {
            "type": "boolean"
          },
          "analog_rules": {
            "type": ["string", "null"]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/definitions/source_ref"
            }
          },
          "review_status": {
            "type": "string",
            "enum": ["auto_ready", "needs_review", "blocked"]
          },
          "review_reason": {
            "type": ["string", "null"]
          }
        }
      }
    }
  },
  "definitions": {
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "raw_artifact_id", "page_or_sheet", "quote"],
      "properties": {
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "raw_artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "page_or_sheet": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
